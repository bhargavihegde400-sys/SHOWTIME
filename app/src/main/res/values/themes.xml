<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.QuickBooking" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/terracotta</item>
        <item name="colorPrimaryVariant">@color/terracotta_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/terracotta</item>
        <item name="android:windowBackground">@color/cream_dark</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/cream_dark</item>
    </style>

    <style name="Theme.QuickBooking.Red" parent="Theme.QuickBooking">
        <item name="android:windowBackground">@color/terracotta_dark</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/terracotta_dark</item>
    </style>

    <style name="Theme.QuickBooking.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/terracotta</item>
        <item name="colorPrimaryVariant">@color/terracotta_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowBackground">@color/cream_light</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/terracotta</item>
    </style>

</resources>
