<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@color/card_dark">

    <TextView
        android:id="@+id/tvFilterTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Filter Events"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvCityLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="City"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvFilterTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Spinner
        android:id="@+id/spinnerFilterCity"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edittext"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:spinnerMode="dropdown"
        app:layout_constraintTop_toBottomOf="@id/tvCityLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvPriceLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Price Range"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/spinnerFilterCity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RadioGroup
        android:id="@+id/rgFilterPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvPriceLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/rbAllPrices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:buttonTint="@color/terracotta"
            android:text="All Prices"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/rbUnder500"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/terracotta"
            android:text="Under ₹500"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/rb500To1000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/terracotta"
            android:text="₹500 – ₹1,000"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/rbAbove1000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/terracotta"
            android:text="Above ₹1,000"
            android:textColor="@color/white" />

    </RadioGroup>

    <Button
        android:id="@+id/btnResetFilters"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/terracotta"
        android:text="Reset"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/rgFilterPrice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnApplyFilters" />

    <Button
        android:id="@+id/btnApplyFilters"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="@color/terracotta"
        android:text="Apply Filters"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/rgFilterPrice"
        app:layout_constraintStart_toEndOf="@id/btnResetFilters"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
