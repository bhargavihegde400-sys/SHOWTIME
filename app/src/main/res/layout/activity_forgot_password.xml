<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btnBackForgot"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset Password"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your email, registered phone number, and new password"
            android:textColor="@color/text_secondary_dark"
            android:textSize="14sp"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_edittext"
            android:hint="Email Address"
            android:textColor="@color/white"
            android:textColorHint="@color/text_secondary_dark"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:autofillHints="emailAddress"/>

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_edittext"
            android:hint="Registered Phone Number"
            android:textColor="@color/white"
            android:textColorHint="@color/text_secondary_dark"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:autofillHints="phone"/>

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_edittext"
            android:hint="New Password"
            android:textColor="@color/white"
            android:textColorHint="@color/text_secondary_dark"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:autofillHints="password"/>

        <Button
            android:id="@+id/btnResetSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/terracotta"
            android:text="Update Password"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"/>

    </LinearLayout>

</ScrollView>
