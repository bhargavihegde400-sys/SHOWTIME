<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:id="@+id/main">

    <ImageView
        android:layout_width="220dp"
        android:layout_height="110dp"
        app:srcCompat="@drawable/logo_show"
        android:contentDescription="Showtime Logo"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Book Movies, Live Shows &amp; Events Instantly"
        android:textColor="@color/text_secondary_dark"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/terracotta"
        android:text="Login"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:cornerRadius="8dp"/>

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/card_dark"
        android:text="Create Account"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:cornerRadius="8dp"
        app:strokeColor="@color/terracotta"
        app:strokeWidth="1dp"/>

    <Button
        android:id="@+id/btnAdminLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@android:color/transparent"
        android:text="Admin Portal"
        android:textColor="@color/text_secondary_dark"
        android:textSize="14sp"
        app:cornerRadius="8dp"/>

</LinearLayout>
