<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile &amp; Settings"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etProfileName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_edittext"
            android:hint="Full Name"
            android:textColor="@color/white"
            android:textColorHint="@color/text_secondary_dark"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:autofillHints="name"/>

        <EditText
            android:id="@+id/etProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_edittext"
            android:hint="Email Address"
            android:enabled="false"
            android:textColor="@color/text_secondary_dark"
            android:textColorHint="@color/text_secondary_dark"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:autofillHints="emailAddress"/>

        <EditText
            android:id="@+id/etProfilePhone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_edittext"
            android:hint="Phone Number"
            android:textColor="@color/white"
            android:textColorHint="@color/text_secondary_dark"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:autofillHints="phone"/>

        <Button
            android:id="@+id/btnUpdateProfile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/terracotta"
            android:text="Update Profile"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            app:cornerRadius="8dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/card_dark"
            android:text="Logout"
            android:textColor="@color/terracotta"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/terracotta"
            app:strokeWidth="1dp"/>

        <Button
            android:id="@+id/btnExitApp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@android:color/transparent"
            android:text="Exit App"
            android:textColor="@color/text_secondary_dark"
            android:textSize="15sp"
            app:cornerRadius="8dp"/>

    </LinearLayout>

</ScrollView>
