<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/userHomeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_dark">

    <!-- Top Bar with Hamburger & Title -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivHamburger"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_menu"
            android:contentDescription="Menu"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SHOWTIME"
            android:textColor="@color/terracotta"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <ImageView
            android:id="@+id/ivProfileIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_my_calendar"
            android:contentDescription="Profile"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Search Bar with Filter Icon Inside -->
    <LinearLayout
        android:id="@+id/searchFilterLayout"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_edittext"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        app:layout_constraintTop_toBottomOf="@id/topBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Search movies, music, comedy, city..."
            android:textColor="@color/white"
            android:textColorHint="@color/text_secondary_dark"
            android:inputType="text"
            android:singleLine="true"
            android:padding="0dp"
            android:autofillHints="name" />

        <ImageButton
            android:id="@+id/btnFilter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="Filter events"
            app:tint="@color/terracotta" />
    </LinearLayout>

    <!-- Categories Horizontal Scroll -->
    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/searchFilterLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/terracotta"
                android:text="All"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"
                app:cornerRadius="18dp" />

            <Button
                android:id="@+id/filterMovies"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/card_dark"
                android:text="Movies"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"
                app:cornerRadius="18dp" />

            <Button
                android:id="@+id/filterMusic"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/card_dark"
                android:text="Music"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"
                app:cornerRadius="18dp" />

            <Button
                android:id="@+id/filterComedy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/card_dark"
                android:text="Comedy"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"
                app:cornerRadius="18dp" />

            <Button
                android:id="@+id/filterCultural"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/card_dark"
                android:text="Cultural"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"
                app:cornerRadius="18dp" />

            <Button
                android:id="@+id/filterPlays"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/card_dark"
                android:text="Plays"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"
                app:cornerRadius="18dp" />

            <Button
                android:id="@+id/filterWorkshops"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/card_dark"
                android:text="Workshops"
                android:textColor="@color/white"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Section Title -->
    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Recommendations >"
        android:textColor="@color/terracotta"
        android:textSize="14sp"
        android:textStyle="italic"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/categoryScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Events List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEvents"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvSectionTitle"
        app:layout_constraintBottom_toTopOf="@id/bottomNavLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/card_dark"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:backgroundTint="@android:color/transparent"
            android:text="Home"
            android:textColor="@color/terracotta"
            android:textSize="12sp" />

        <Button
            android:id="@+id/navBookings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:backgroundTint="@android:color/transparent"
            android:text="Bookings"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp" />

        <Button
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:backgroundTint="@android:color/transparent"
            android:text="Profile"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
