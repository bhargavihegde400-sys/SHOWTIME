<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvBookingEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvBookingShowtime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Showtime: 2026-11-01"
            android:textColor="@color/text_secondary_dark"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvBookingSeats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seats: A1, A2"
            android:textColor="@color/text_secondary_dark"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvBookingFare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="₹500"
                android:textColor="@color/terracotta"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvBookingDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-10-25 15:00"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnCancelBooking"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:backgroundTint="@color/card_dark"
            android:text="Cancel Booking"
            android:textColor="@color/terracotta"
            android:textSize="12sp"
            app:cornerRadius="6dp"
            app:strokeColor="@color/terracotta"
            app:strokeWidth="1dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
